# AdSpark optional AI proxy configuration.
# Copy this file to ".env" and fill in the values. Never commit ".env".
# Without these values AdSpark uses its local template engine only.

# Provider: "openai" (any OpenAI-compatible Chat Completions API) or "anthropic"
AI_PROVIDER=
# Secret API key for the provider. Read only by the server, never sent to the browser.
AI_API_KEY=
# Exact model identifier offered by your provider account (required, no default).
AI_MODEL=
# Optional: custom base URL for OpenAI-compatible providers (default https://api.openai.com/v1)
AI_BASE_URL=
# Usage limits
AI_DAILY_LIMIT_PER_CLIENT=20
AI_DAILY_LIMIT_TOTAL=200
# Port for the AdSpark server
ADSPARK_SERVER_PORT=8787
