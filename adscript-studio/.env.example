# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override. Default: claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Credits one generation costs
CREDITS_PER_GENERATION=1

# --- Gumroad credit packs ---
# One Gumroad product per pack, with "Generate a unique license key" enabled.
# productId: Gumroad product ID (product edit page -> License key section).
# Write prices as \$5 (escape the dollar sign) or Next.js will treat $5 as a variable.
GUMROAD_PRODUCTS=[{"productId":"REPLACE_ME_1","name":"Starter","credits":20,"price":"\$5","url":"https://YOURNAME.gumroad.com/l/starter"},{"productId":"REPLACE_ME_2","name":"Creator","credits":60,"price":"\$12","url":"https://YOURNAME.gumroad.com/l/creator"},{"productId":"REPLACE_ME_3","name":"Agency","credits":200,"price":"\$29","url":"https://YOURNAME.gumroad.com/l/agency"}]

# Secret token for the Gumroad refund webhook URL (/api/gumroad/webhook?token=...).
# Generate one with: openssl rand -hex 24
GUMROAD_WEBHOOK_TOKEN=
