# --- channel ---
CHANNEL_START_DATE=2026-11-18      # day 1 of the channel (growth phases count from here)
CHANNEL_HANDLE=@YourChannelHandle  # used for the subscribe link in descriptions
CHANNEL_LANGUAGE=en
PUBLISH_TIME_LONG_UTC=16:00        # 20:00 Baku, 11:00 New York
PUBLISH_TIME_SHORT_UTC=22:00       # 02:00 Baku, 17:00 New York
SUBSCRIBER_GOAL=1000
PLAN_DAYS_AHEAD=14

# --- upload ---
UPLOAD_MODE=api        # api = system uploads to YouTube | manual = only export copy-paste packs
PUBLISH_MODE=private   # private = uploaded private, you make it public in Studio | scheduled = YouTube publishes at the time above
UPLOAD_AHEAD_HOURS=36  # upload ready videos this many hours before their publish time
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=      # from: python scripts/get_refresh_token.py
YT_DAILY_QUOTA=10000
YT_UPLOAD_COST=1600    # quota units per upload; check your Google Cloud console

# --- optional: Claude polishes titles / hooks / pinned comment ---
ANTHROPIC_API_KEY=
LLM_ENABLED=auto       # auto = on when a key is set | on | off
LLM_MODEL=claude-opus-5-5

# --- dashboard ---
DASHBOARD_PASSWORD=    # set this if the dashboard is reachable from the internet
