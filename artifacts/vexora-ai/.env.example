# ─────────────────────────────────────────────────────────────────────────────
# Vexora AI — web app (build-time, public). Never put secrets here:
# everything in this file ends up in the browser bundle.
# Payment keys belong in artifacts/api-server/.env only.
# ─────────────────────────────────────────────────────────────────────────────

# API base URL. Default: same origin `/api` (the dev server proxies it to API_PORT).
# VITE_API_URL=https://api.your-domain.az/api

# `demo` = run without a server (data lives in the visitor's browser). For static previews only.
# VITE_BACKEND=demo

# Dev/preview proxy target for /api
API_PORT=8080
