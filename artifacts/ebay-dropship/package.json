{
  "name": "@workspace/ebay-dropship",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "eBay dropshipping automation: research, AI listings, publishing, stock sync, auto-fulfillment, tracking",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.3.0",
    "zod": "^4.6.7",
    "fast-xml-parser": "^5.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
