# ===== Rejim =====
# true = sistem hər şeyi edir, amma eBay və CJ-də REAL heç nə dəyişmir (test üçün).
# Hər şey düzgün qurulandan sonra false et.
DRY_RUN=true
# true = CJ olmadan demo məhsullarla sına
DEMO_SUPPLIER=false

# ===== Panel =====
PORT=3000
# Boş saxlasan, parol soruşulmur (yalnız öz kompüterində açılır)
DASHBOARD_PASSWORD=

# ===== eBay (developer.ebay.com -> Application Keys -> Production) =====
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# User Tokens -> "Get a Token from eBay via Your Application" -> RuName (eBay Redirect URL name)
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=EBAY_US

# ===== CJdropshipping (cjdropshipping.com -> My CJ -> Authorization -> API -> API Key) =====
CJ_API_KEY=

# ===== Claude AI (console.anthropic.com -> API Keys). Boş olsa, sadə template işlədilir =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ===== Telegram bildirişləri (istəyə görə) =====
# @BotFather-dən bot yarat, token-i bura yaz. chat_id üçün bota mesaj yaz və
# https://api.telegram.org/bot<TOKEN>/getUpdates açıb "chat":{"id": ...} rəqəmini götür.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
