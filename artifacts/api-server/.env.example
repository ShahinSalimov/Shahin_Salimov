# ─────────────────────────────────────────────────────────────────────────────
# Vexora AI — API server configuration
# Copy to `.env` (git-ignored) and fill in. `pnpm start` loads it automatically.
# Never commit real keys. SECRET_KEY stays on the server; the browser never sees it.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/vexora
# Emails that become admin (Cashbox access) on sign-in, comma-separated
ADMIN_EMAILS=owner@example.com

# ── Payments ────────────────────────────────────────────────────────────────
# true  = paid plans and credit packs can be bought
# false = free launch: pricing shows "Coming soon", no checkout
# (default: true in development, false in production)
PAYMENTS_ENABLED=true

# sandbox = built-in simulated gateway: full flow, signed callbacks, NO real cards or money.
#           Blocked when NODE_ENV=production (unless ALLOW_SANDBOX_IN_PRODUCTION=true on a private staging server).
# live    = real gateway below; every key in this block becomes required and is checked at start-up.
PAYMENT_MODE=sandbox

# Live gateway: epoint | payriff   (to add a bank's acquiring, see services/payment/index.ts)
PAYMENT_GATEWAY=epoint

# Merchant credentials from the gateway's merchant cabinet
#   Epoint : MERCHANT_ID = public_key,  SECRET_KEY = private_key
#   Payriff: MERCHANT_ID = merchant id (optional), SECRET_KEY = secret key (sent as Authorization header)
MERCHANT_ID=
SECRET_KEY=

# Public HTTPS URL of the server endpoint that receives payment results (server-to-server).
#   Epoint : also enter this as the result/callback URL in the Epoint cabinet.
CALLBACK_URL=https://your-domain.az/api/payment/callback

# Where the customer's browser is sent after paying. `order_id` is appended automatically.
SUCCESS_URL=https://your-domain.az/payment/success
ERROR_URL=https://your-domain.az/payment/failed

# Optional
# Language of the gateway page: az | en | ru
PAYMENT_LANGUAGE=az
# Shown on the payment page and in the order description
MERCHANT_NAME=Vexora AI
# EPOINT_API_URL=https://epoint.az/api/1
# PAYRIFF_API_URL=https://api.payriff.com/api/v3
# ALLOW_SANDBOX_IN_PRODUCTION=false

# ── Accounts & AI ───────────────────────────────────────────────────────────
SIGNUP_ENABLED=true
# Free credits per new account (real AI costs money — keep low)
SIGNUP_CREDITS=30
AI_PROVIDER=mock
# Only if the web app is served from another origin
# CORS_ORIGIN=https://your-domain.az
