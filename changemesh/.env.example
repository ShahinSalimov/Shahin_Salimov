# ---------------------------------------------------------------------------
# CHANGEMESH environment variables. Copy to .env.local and fill in.
# Full reference: ENVIRONMENT.md
# ---------------------------------------------------------------------------

# Public base URL (used for auth email links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Dashboard -> Project Settings -> API).
# The anon key is public by design; data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Show the "Continue with Google" button (requires the Google provider in Supabase Auth).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# "enabled" lets visitors explore fictional demo data without an account.
CHANGEMESH_DEMO_MODE=enabled

# debug | info | warn | error
LOG_LEVEL=info

# Optional AI-assisted impact analysis. "none" = rule-based only (default).
CHANGEMESH_AI_PROVIDER=none
# SERVER ONLY. Required when CHANGEMESH_AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
CHANGEMESH_AI_MODEL=

# ---------------------------------------------------------------------------
# Billing — Stripe TEST MODE ONLY. Live keys (sk_live_/rk_live_) are refused.
# ---------------------------------------------------------------------------
# SERVER ONLY. sk_test_… or rk_test_…
STRIPE_SECRET_KEY=
# SERVER ONLY. Signing secret of the webhook endpoint (whsec_…), /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Recurring monthly price ids (price_…) created in the Stripe test dashboard.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=

# Comma-separated emails that may open /admin (read-only platform overview).
CHANGEMESH_PLATFORM_ADMIN_EMAILS=
