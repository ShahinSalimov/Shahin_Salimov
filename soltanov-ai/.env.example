# --- Edition: trial = 3 günlük link forması, full = tam tətbiq forması ---
EDITION=trial
PORT=5000
PUBLIC_URL=https://sizin-domen.az

# Məcburi sirlər — yaratmaq üçün: npm run admin -- secrets
SESSION_SECRET=
ADMIN_TOKEN=

# Test parametrləri
TRIAL_HOURS=72
TRIAL_MAX_DEVICES=2
TRIAL_DAILY_AD_LIMIT=10
TRIAL_DAILY_REFRESH_LIMIT=6
TRIAL_DAILY_CUSTOM_LIMIT=8
FULL_MAX_DEVICES=3

# Gündəlik slotlar
TIMEZONE=Asia/Baku
IDEA_SLOTS=09:00,13:00,19:00
IDEAS_PER_SLOT=3

# AI (boşdursa offline şablon rejimi işləyir)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Səs → mətn (opsional, boşdursa brauzer nitq tanıması / əl ilə)
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# Telegram bildirişi (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Blok ekranındakı əlaqə düyməsi
OWNER_NAME=Şahin Səlimov
OWNER_CONTACT_URL=https://wa.me/994XXXXXXXXX
