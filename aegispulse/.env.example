# ---------------------------------------------------------------------------
# AegisPulse configuration. Copy to .env and fill in the values marked REQUIRED.
#   cp .env.example .env
# Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# production | development (development allows running without API keys)
AEGIS_ENV=production
AEGIS_LOG_LEVEL=INFO

# --- Database (REQUIRED) -----------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aegispulse
# Only for running the backend outside Docker (compose builds these itself):
# DATABASE_URL=postgresql+asyncpg://aegis:change-me-strong-password@localhost:5432/aegispulse
# REDIS_URL=redis://localhost:6379/0

# --- Authentication (REQUIRED) -------------------------------------------------
# Signs dashboard session tokens. Generate: openssl rand -hex 32
AEGIS_SECRET_KEY=replace-with-64-hex-characters
AEGIS_SESSION_TTL_HOURS=12
# First admin user, created on first start when no users exist (for the first company).
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=change-me-Strong-Passw0rd
AEGIS_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Optional operator ("platform") keys with access to ALL tenants: provisioning, support.
# Tenant-scoped keys for SIEMs/scripts are created in the dashboard (Team -> API keys).
AEGIS_API_KEYS=
AEGIS_CORS_ORIGINS=http://localhost:3000
AEGIS_RATE_LIMIT_PER_MINUTE=120
# Tighter limit for endpoints that spend model tokens (analyze, simulate-attack).
AEGIS_EXPENSIVE_RATE_LIMIT_PER_MINUTE=10

# --- AI engine (REQUIRED for analysis) ----------------------------------------
ANTHROPIC_API_KEY=
AEGIS_MODEL=claude-opus-5-5
AEGIS_TRIAGE_EFFORT=medium
AEGIS_CONTEXT_EFFORT=high
AEGIS_REMEDIATION_EFFORT=high
# Server-side refusal fallbacks (beta); set false on Bedrock/Vertex/Foundry.
AEGIS_ENABLE_FALLBACKS=true
AEGIS_ANALYSIS_CONCURRENCY=4

# --- Alerting (optional; unconfigured channels are logged as "skipped") ------
AEGIS_ALERT_SEVERITY_THRESHOLD=8.0
AEGIS_AUTO_DISPATCH_ALERTS=true
AEGIS_DASHBOARD_URL=http://localhost:3000
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated E.164 numbers, e.g. +15551234567,+15557654321
TWILIO_WHATSAPP_TO=
# SOAR / SIEM HTTPS endpoint and its HMAC-SHA256 signing secret (X-Aegis-Signature).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --- Data retention ------------------------------------------------------------
# Redact raw collected text after N days (0 = keep forever). Set per your legal policy.
AEGIS_RAW_TEXT_RETENTION_DAYS=90
AEGIS_AUDIT_RETENTION_DAYS=400

# --- Collectors -----------------------------------------------------------------
# Comma-separated: nvd, telegram, paste, darkweb_feed (each also needs its settings below).
AEGIS_COLLECTORS=nvd
# Hard cap on new items per collector run (bounds AI spend).
AEGIS_COLLECTOR_MAX_ITEMS_PER_RUN=25
# Free key: https://nvd.nist.gov/developers/request-an-api-key (raises rate limit 5 -> 50 req/30s)
NVD_API_KEY=
NVD_MIN_CVSS=7.0
# Public channel usernames only, e.g. channel_one,channel_two (read via https://t.me/s/<name>)
TELEGRAM_CHANNELS=
# Pastebin Scraping API requires a PRO account with this server's IP whitelisted.
PASTE_SCRAPE_URL=https://scrape.pastebin.com
# Licensed dark-web intelligence feed (HTTPS JSON); see backend/collectors/darkweb_feed.py
DARKWEB_FEED_URL=
DARKWEB_FEED_TOKEN=

# --- Ports ----------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
