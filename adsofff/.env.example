# AdSofff optional AI proxy configuration.
# Copy this file to ".env" and fill in the values. Never commit ".env".
# Without these values AdSofff runs in Demo Generation mode (local templates, not AI).
# These variables are read only by the AdSofff server (server/), never by the browser.

# Provider: "anthropic" (official Anthropic SDK) or "openai" (official OpenAI SDK; also
# works with OpenAI-compatible endpoints via AI_BASE_URL)
AI_PROVIDER=
# Secret API key for the provider.
AI_API_KEY=
# Exact model ID your account can use (required, no default is assumed).
# Example for Anthropic: claude-opus-5-5
AI_MODEL=
# Optional custom endpoint. Must be https:// (http:// only for localhost).
# Leave empty to use the provider's official endpoint.
AI_BASE_URL=
# OpenAI path only: "auto" = strict JSON schema on api.openai.com, json_object elsewhere;
# "on" / "off" to force it for a compatible endpoint.
AI_STRUCTURED_OUTPUT=auto
# Usage limits (requests per UTC day)
AI_DAILY_LIMIT_PER_CLIENT=20
AI_DAILY_LIMIT_TOTAL=200
# Port for the AdSofff server
ADSOFFF_SERVER_PORT=8787
