# Shuker OS ayarları. Bu faylı .env adı ilə kopyalayın və doldurun.
# .env faylını heç vaxt GitHub-a yükləməyin.

# --- Ümumi ---
PORT=3000
# Serverin ictimai ünvanı (Instagram webhook və Media Kit linki üçün), məs. https://os.example.com
PUBLIC_URL=
DB_PATH=./data/shuker.db
APP_NAME=Shuker OS
OWNER_NAME=Şükran
# AI sahibi necə tanısın: kimdir, nə ilə məşğuldur
OWNER_DESCRIPTION=bloger, aktyor və idmançı
TIMEZONE=Asia/Baku
TZ_OFFSET=+04:00
# Maliyyəni kim görür: none = yalnız sahib, manager = sahib + menecerlər
TEAM_FINANCE_ACCESS=none

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high
ANTHROPIC_EFFORT=medium
# İmtina halında avtomatik ehtiyat modelə keçid (server-side fallback)
AI_FALLBACKS=true

# --- Telegram ---
# @BotFather-dən alınan token
TELEGRAM_BOT_TOKEN=
# Şükranın Telegram ID-si (botda /id yazanda görünür)
OWNER_TELEGRAM_ID=
# Vergüllə: komanda rəhbərləri və üzvlər
MANAGER_TELEGRAM_IDS=
MEMBER_TELEGRAM_IDS=
# Komanda qrupunun chat ID-si (qrupda /id yazın, mənfi rəqəm olur)
TEAM_CHAT_ID=

# --- Səs (OpenAI audio API) ---
OPENAI_API_KEY=
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=onyx
# true olsa səhər brifinqi həm də səsli fayl kimi gəlir
BRIEF_AS_VOICE=false

# --- Planlayıcı ---
BRIEF_TIME=09:00
EVENT_REMINDER_MINUTES=60
REPORT_AFTER_HOURS=48

# --- Panel ---
PANEL_OWNER_PASSWORD=
PANEL_TEAM_PASSWORD=

# --- Instagram / Meta ---
META_GRAPH_HOST=graph.facebook.com
# Meta-nın cari Graph API versiyasını yazın
META_GRAPH_VERSION=v21.0
IG_USER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
# Özünüz uydurduğunuz istənilən söz (Meta webhook ayarında eyni yazılır)
META_VERIFY_TOKEN=
META_INSIGHT_METRICS=reach,likes,comments,shares,saved
