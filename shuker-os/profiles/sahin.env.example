# Şahin üçün test profili. İşlətmək üçün: cp profiles/sahin.env.example .env
# Sonra boş sahələri doldurun. .env faylını heç vaxt GitHub-a yükləməyin və chat-a yazmayın.

PORT=3000
PUBLIC_URL=
DB_PATH=./data/sahin.db
APP_NAME=Şahin OS
OWNER_NAME=Şahin
OWNER_DESCRIPTION=AI mütəxəssisi: sosial şəbəkələr üçün AI reklam videoları, veb saytlar və biznes idarəetmə sistemləri hazırlayır
TIMEZONE=Asia/Baku
TZ_OFFSET=+04:00
TEAM_FINANCE_ACCESS=none

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
AI_FALLBACKS=true

# Telegram: test botu (@BotFather), öz ID-niz (botda /id), istəsəniz test qrupu
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
MANAGER_TELEGRAM_IDS=
MEMBER_TELEGRAM_IDS=
TEAM_CHAT_ID=

# Səs (istəyə görə)
OPENAI_API_KEY=
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=onyx
BRIEF_AS_VOICE=false

BRIEF_TIME=09:00
EVENT_REMINDER_MINUTES=60
REPORT_AFTER_HOURS=48

# Panel şifrələri (uzun və fərqli olsun)
PANEL_OWNER_PASSWORD=
PANEL_TEAM_PASSWORD=

# Instagram: sizin hesabınız (Business/Creator + Facebook Page)
META_GRAPH_HOST=graph.facebook.com
META_GRAPH_VERSION=v21.0
IG_USER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_INSIGHT_METRICS=reach,likes,comments,shares,saved
